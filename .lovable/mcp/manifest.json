{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ebwfroqkuibiiyxcouip.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "morning-market-brief",
      "version": "0.1.0",
      "title": "Morning Market Brief"
    },
    "tools": [
      {
        "name": "get_latest_report",
        "title": "Get latest morning report",
        "description": "Return the most recent Close & Open daily market report (headline, summary, full text and sources).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_report",
        "title": "Get report by date",
        "description": "Return the Close & Open market report for a specific date (YYYY-MM-DD).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Report date, YYYY-MM-DD."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_reports",
        "title": "Search report archive",
        "description": "List past Close & Open reports, newest first, optionally filtered by keyword and/or month.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Keyword to match in headline, summary or text.",
              "type": "string",
              "maxLength": 100
            },
            "month": {
              "description": "Month filter, YYYY-MM.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "limit": {
              "default": 10,
              "description": "Maximum results (1–50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_economic_calendar",
        "title": "Get economic calendar",
        "description": "List scheduled economic releases and central bank events for the next N days (times in ET).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "days": {
              "default": 7,
              "description": "How many days ahead (1–30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_economic_data",
        "title": "Get economic data (FRED)",
        "description": "Latest and prior observations from FRED for Treasury yields, SOFR, EFFR, unemployment, CPI, payrolls, mortgage rates and diesel. LIBOR is not available (discontinued).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "series": {
              "minItems": 1,
              "maxItems": 17,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "DGS1MO",
                  "DGS3MO",
                  "DGS6MO",
                  "DGS1",
                  "DGS2",
                  "DGS5",
                  "DGS10",
                  "DGS30",
                  "SOFR",
                  "EFFR",
                  "DFF",
                  "UNRATE",
                  "CPIAUCSL",
                  "CPILFESL",
                  "PAYEMS",
                  "MORTGAGE30US",
                  "GASDESW"
                ]
              },
              "description": "FRED series IDs."
            }
          },
          "required": [
            "series"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
